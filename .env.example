# Postgres connection string (Neon, Supabase, or local). Prisma reads this via prisma.config.ts.
DATABASE_URL=

# Optional: direct (unpooled) Postgres URL used only for `prisma migrate deploy` during the
# build. Set this on Vercel to the non-pooler Neon host if migrations stall on the pooler.
DIRECT_URL=

# api-sports.io API-Football key. Free tier = 100 requests/day; see /lib/api-football/client.ts
# for the caching + quota guard that protects it.
API_FOOTBALL_KEY=

# Anthropic Messages API key for the AI review layer (/lib/predictions/ai/). Not needed until Phase 2b.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
# full = base model + AI adjustment; reasoning_only = AI only writes explanations; off = base model only.
AI_LAYER_MODE=reasoning_only

# Minimum probability (0-100) required to publish a tip.
CONFIDENCE_FLOOR=40
PREMIUM_CONFIDENCE_FLOOR=92   # confidence at or above which a pick is premium (paywalled) by default; admin can also force any pick premium

# Manual sync jobs (npm run sync:fixtures etc.) can be scoped to one job at a time to save API quota.
# One of: fixtures | stats | results | predictions. Omit to run everything.
SYNC_MODE=

# NextAuth (Phase 6). NEXTAUTH_SECRET must be >= 32 chars - src/lib/auth.ts
# fails fast at import time if it's missing or too short. Generate one with
# `openssl rand -base64 32`.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Resend (transactional email - account verification + password reset links,
# see src/lib/email/). Free tier at resend.com; verify your sending domain
# there before EMAIL_FROM can send to arbitrary recipients.
RESEND_API_KEY=
EMAIL_FROM=

# Paystack (Phase 7). Set the webhook URL in the Paystack dashboard to
# <NEXT_PUBLIC_SITE_URL>/api/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Shared secret required on Vercel Cron / manual requests to /api/cron/* routes.
CRON_SECRET=

# Public site origin (no trailing slash) - used for canonical URLs, OpenGraph tags,
# and the sitemap. Falls back to http://localhost:3000 if unset. Set this for real
# before deploying, or every canonical/OG URL will point at localhost.
NEXT_PUBLIC_SITE_URL=

# Google AdSense publisher ID (e.g. pub-1234567890123456, from the AdSense dashboard
# once the site is approved). Leave unset to load no ad script at all - see
# /lib/ads.config.ts.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Analytics 4 measurement ID (defaults to the production property; "off" disables)
NEXT_PUBLIC_GA_ID=
