generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// API-Football response cache + daily quota guard (see /lib/api-football/client.ts)
// ---------------------------------------------------------------------------

model ApiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  endpoint  String
  response  Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model ApiQuotaUsage {
  id    String @id @default(cuid())
  date  String @unique // UTC day, "YYYY-MM-DD"
  count Int    @default(0)
}

// Single-row, cross-process per-minute counter. The build, cron syncs, and
// serverless requests each run in their own process, so an in-memory counter
// can't see what the others are using against the same account-wide cap -
// this table is the shared source of truth.
model ApiRateLimitWindow {
  id          String   @id
  windowStart DateTime
  count       Int      @default(0)
}

// ---------------------------------------------------------------------------
// Football data (synced from API-Football via /lib/api-football/client.ts)
// ---------------------------------------------------------------------------

model League {
  id         String   @id @default(cuid())
  apiId      Int      @unique
  name       String
  country    String
  logoUrl    String?
  slug       String   @unique
  isFeatured Boolean  @default(false)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Last time syncStats finished refreshing this league's teams/standings/scorers.
  // syncStats processes leagues stalest-first and time-boxes each run, so this is
  // how it picks up where the previous run left off. Null = never synced.
  statsSyncedAt DateTime?

  teams     Team[]
  fixtures  Fixture[]
  standings Standing[]
  topScorers TopScorer[]

  @@index([isFeatured, priority])
}

model Team {
  id        String  @id @default(cuid())
  apiId     Int     @unique
  name      String
  shortName String?
  logoUrl   String?
  leagueId  String

  league League @relation(fields: [leagueId], references: [id])

  homeFixtures Fixture[]   @relation("HomeTeam")
  awayFixtures Fixture[]   @relation("AwayTeam")
  stats        TeamStats[]
  standings    Standing[]
  topScorers   TopScorer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId])
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
  POSTPONED
  CANCELLED
  ABANDONED
}

model Fixture {
  id         String        @id @default(cuid())
  apiId      Int           @unique
  leagueId   String
  homeTeamId String
  awayTeamId String
  kickoffUtc DateTime
  status     FixtureStatus @default(SCHEDULED)

  homeScore      Int?
  awayScore      Int?
  htHomeScore    Int?
  htAwayScore    Int?
  /// Minutes played, from API-Football's fixture.status.elapsed. Only meaningful while LIVE/HALFTIME.
  elapsedMinutes Int?
  venue          String?

  league   League @relation(fields: [leagueId], references: [id])
  homeTeam Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  prediction Prediction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId])
  @@index([kickoffUtc])
  // Team recent-form / H2H lookups filter ("homeTeamId" = x OR "awayTeamId" = x);
  // Postgres BitmapOrs these two. Prisma doesn't auto-index relation FKs on PG.
  @@index([homeTeamId])
  @@index([awayTeamId])
  // sync-results (status IN (...) AND kickoffUtc <= now) and generate-predictions
  // (status = SCHEDULED AND kickoffUtc BETWEEN ...) both filter status + kickoff.
  // Leftmost prefix still serves plain status lookups, so this replaces @@index([status]).
  @@index([status, kickoffUtc])
}

model TeamStats {
  id     String @id @default(cuid())
  teamId String
  season Int

  played  Int @default(0)
  wins    Int @default(0)
  draws   Int @default(0)
  losses  Int @default(0)

  goalsFor     Int @default(0)
  goalsAgainst Int @default(0)

  homeGoalsFor     Int @default(0)
  homeGoalsAgainst Int @default(0)
  awayGoalsFor     Int @default(0)
  awayGoalsAgainst Int @default(0)

  cleanSheets   Int    @default(0)
  failedToScore Int    @default(0)
  form          String? // last 5 results, e.g. "WWDLW"

  team Team @relation(fields: [teamId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([teamId, season])
}

model Standing {
  id       String @id @default(cuid())
  leagueId String
  teamId   String
  season   Int

  rank     Int
  played   Int
  points   Int
  goalDiff Int

  league League @relation(fields: [leagueId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([leagueId, teamId, season])
  @@index([leagueId, season])
}

model TopScorer {
  id           String @id @default(cuid())
  leagueId     String
  playerName   String
  playerApiId  Int?
  photoUrl     String? // API-Football headshot, e.g. https://media.api-sports.io/football/players/<id>.png
  teamId       String
  goals        Int
  appearances  Int
  season       Int

  league League @relation(fields: [leagueId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([leagueId, teamId, playerName, season])
  @@index([leagueId, season])
}

// ---------------------------------------------------------------------------
// Prediction engine output
// ---------------------------------------------------------------------------

enum PredictionMarket {
  HOME_WIN
  AWAY_WIN
  DRAW
  DOUBLE_CHANCE_1X
  DOUBLE_CHANCE_X2
  DOUBLE_CHANCE_12
  DRAW_NO_BET_HOME
  DRAW_NO_BET_AWAY
  OVER_1_5
  UNDER_1_5
  OVER_2_5
  UNDER_2_5
  OVER_3_5
  UNDER_3_5
  BTTS_YES
  BTTS_NO
  CORRECT_SCORE
  HT_OVER_0_5
}

enum SettledStatus {
  PENDING
  WON
  LOST
  VOID
}

// Whether a pick sits behind the premium paywall. AUTO = decided by the
// PREMIUM_CONFIDENCE_FLOOR threshold; ALWAYS / NEVER = admin override.
enum PremiumMode {
  AUTO
  ALWAYS
  NEVER
}

model Prediction {
  id        String @id @default(cuid())
  fixtureId String @unique

  market     PredictionMarket
  selection  String
  odds       Decimal           @db.Decimal(5, 2)
  confidence Int
  premium    PremiumMode       @default(AUTO)
  isBanker   Boolean           @default(false)
  reasoning  String            @db.Text
  settledAs  SettledStatus     @default(PENDING)

  isManualOverride Boolean @default(false)

  // Stage 1 (statistical model) output, kept even after AI adjustment for comparison.
  baseMarket     PredictionMarket?
  baseSelection  String?
  baseConfidence Int?

  // Full stage-1 market breakdown, for the match detail page's "all markets
  // with probabilities" view - the published pick above is just the top one.
  // Shape: { market: PredictionMarket, selection: string, probability: number }[]
  allMarkets       Json?
  expectedGoalsHome Float?
  expectedGoalsAway Float?

  // Stage 2 (AI layer) metadata.
  aiAdjusted       Boolean  @default(false)
  adjustmentReason String?  @db.Text
  aiModel          String?
  generatedAt      DateTime?

  fixture Fixture @relation(fields: [fixtureId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([settledAs])
  @@index([premium])
  @@index([isBanker])
  // market-coverage groupBy(market) and the results archive's market filter.
  @@index([market])
}

// Small admin-controlled key/value flags (e.g. "gamesToday" - see lib/site-settings.ts).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// Sponsors / partner sites shown in the public footer (Admin > Partners). Links are rel="sponsored nofollow"
// unless `sponsored` is switched off.
model Partner {
  id          String   @id @default(cuid())
  name        String
  url         String
  logoUrl     String?
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  sponsored   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

// Admin-editable <title>/<meta description> overrides, keyed by public path ("/", "/leagues", ...).
// A null field means "use the page's built-in default". See lib/page-seo.ts.
model PageSeo {
  path        String   @id
  title       String?
  description String?
  updatedAt   DateTime @default(now()) @updatedAt
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

enum PostType {
  ARTICLE // normal editorial content
  GUEST   // guest / sponsored submission, unlisted by default
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  body        String    @db.Text // Markdown, rendered + sanitized in /lib/markdown.ts
  coverImage  String?
  publishedAt DateTime?
  author      String

  type            PostType @default(ARTICLE)
  /// Appears in the /blog index, homepage "latest posts", and sitemap. Unlisted posts still
  /// have a working public URL - they're just not surfaced in navigation or feeds.
  listed          Boolean  @default(true)
  /// Emits <meta robots noindex> and drops the URL from sitemap.xml entirely.
  noindex         Boolean  @default(false)
  /// Renders a sponsored-content disclosure and marks outbound links rel="sponsored nofollow".
  sponsored       Boolean  @default(false)
  excerpt         String?  @db.Text
  /// Free-form topic tags shown on the post page and used as meta keywords.
  tags            String[] @default([])
  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
  @@index([type, listed, publishedAt])
}

// ---------------------------------------------------------------------------
// Auth & billing
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(USER)
  /// Null until the user clicks a verification link. Timestamp, not a bool,
  /// so support/debugging can see *when* - matches the NextAuth adapter
  /// convention in case a database session strategy is ever adopted.
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscriptions       Subscription[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

// Raw tokens never touch the DB - only their sha256 hash does, same principle
// as passwordHash. The raw value exists only in memory long enough to build
// the emailed link. Kept separate from PasswordResetToken (not a shared
// generic table) since the two have different TTLs and invalidation rules.
model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Shared by every auth endpoint that needs "N attempts per key per window"
// (login, registration, password-reset requests, resend-verification) - one
// table with a bucket discriminator, since all four want identical semantics.
// Same single-row-per-key atomic-upsert-with-window pattern as
// ApiRateLimitWindow above, just parameterized by "<bucket>:<key>" instead of
// a hardcoded id.
model AuthRateLimit {
  id          String   @id
  bucket      String
  windowStart DateTime
  count       Int      @default(0)

  @@index([bucket])
}

enum SubscriptionPlan {
  WEEKLY
  MONTHLY
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id         String             @id @default(cuid())
  userId     String
  plan       SubscriptionPlan
  status     SubscriptionStatus @default(ACTIVE)
  startsAt   DateTime
  expiresAt  DateTime
  paystackRef String            @unique
  /// Amount actually paid, in kobo. Null for admin grants and pre-existing rows.
  amountKobo  Int?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

/// Cover images uploaded from the admin editor. Bytes live in Postgres and are served
/// (immutably cached) from /api/blog-image/[id]; the id is the only handle, never reused.
model PostImage {
  id          String   @id @default(cuid())
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}
