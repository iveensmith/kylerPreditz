{
	"$schema": "node_modules/wrangler/config-schema.json",
	// worker-entry.js wraps OpenNext's generated .open-next/worker.js, adding
	// the "scheduled" handler below (OpenNext has no built-in Cron Triggers
	// support) while passing "fetch" straight through.
	"main": "worker-entry.js",
	"name": "uniquepredict",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"triggers": {
		// Same cadence as today's cron-job.org / GitHub Actions setup - see
		// docs/cron-setup.md and worker-entry.js's CRON_ROUTE_BY_SCHEDULE.
		"crons": ["*/3 * * * *", "*/30 * * * *", "0 */6 * * *", "0 */2 * * *", "0 * * * *"]
	},
	// Secrets are set via `wrangler secret put` (not declared here) - without
	// this, each deploy from a Git push would wipe them, since wrangler syncs
	// bindings to exactly match this file by default.
	"keep_vars": true,
	"vars": {
		"AI_MODEL": "claude-haiku-4-5",
		"AI_LAYER_MODE": "reasoning_only",
		"CONFIDENCE_FLOOR": "40",
		"PREMIUM_CONFIDENCE_FLOOR": "92",
		"PAYSTACK_PUBLIC_KEY": "pk_live_34a2dfde122ac8e005e5433b0d37d432fd92e5f8",
		"EMAIL_FROM": "UniquePredict <noreply@uniquepredict.com>",
		// (NEXT_PUBLIC_SITE_URL isn't listed here - Next.js inlines
		// NEXT_PUBLIC_* vars at build time, from the Build variables, not a
		// live runtime lookup, so a runtime entry here would be a no-op.)
		"NEXTAUTH_URL": "https://uniquepredict.com"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, used by OpenNext for revalidation -
			// the binding/service names must match "name" above.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "uniquepredict"
		}
	],
	"kv_namespaces": [
		{
			// ISR/data-cache store for the ~18 `revalidate`-using routes.
			// KV only (no R2/Queue) - traffic here doesn't warrant them. See
			// https://opennext.js.org/cloudflare/caching
			"binding": "NEXT_INC_CACHE_KV",
			"id": "caa762194f8f4761b6396a1e18ede6fb"
		}
	]
}
